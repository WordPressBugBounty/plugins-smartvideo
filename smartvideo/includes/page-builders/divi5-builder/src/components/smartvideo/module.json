{
  "name": "smartvideo/smartvideo",
  "d4Shortcode": "smartvideo_divi_module",
  "title": "SmartVideo",
  "titles": "SmartVideo Modules",
  "moduleIcon": "smartvideo/smartvideo-icon",
  "moduleClassName": "smartvideo_divi_module",
  "moduleOrderClassName": "smartvideo_divi_module",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "SmartVideo"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "videoUrl": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": ""
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentVideoSource",
            "attrName": "videoUrl.innerContent",
            "priority": 10,
            "render": true,
            "label": "Video URL",
            "description": "Paste a YouTube, Vimeo, Swarmify, or direct video URL",
            "component": {
              "name": "divi/text",
              "type": "field",
              "props": {
                "placeholder": "https://www.youtube.com/watch?v=... or any video URL"
              }
            }
          }
        }
      }
    },
    "mediaLibrary": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": ""
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentVideoSource",
            "attrName": "mediaLibrary.innerContent",
            "priority": 20,
            "render": true,
            "label": "Choose from Media Library",
            "description": "Upload a video from your media library.",
            "component": {
              "name": "divi/upload",
              "type": "field",
              "props": {
                "dataType": "video",
                "chooseText": "Choose a Video",
                "uploadButtonText": "Upload a Video"
              }
            }
          }
        }
      }
    },
    "posterSource": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "none"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPoster",
            "attrName": "posterSource.innerContent",
            "priority": 10,
            "render": true,
            "label": "Poster source",
            "description": "Choose where the poster image comes from, or use the automatic default.",
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "none": {
                    "label": "Automatic"
                  },
                  "media_library": {
                    "label": "Media library"
                  },
                  "another_source": {
                    "label": "Other"
                  }
                }
              }
            }
          }
        }
      }
    },
    "posterImage": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": ""
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPoster",
            "attrName": "posterImage.innerContent",
            "priority": 20,
            "render": true,
            "label": "Poster image",
            "description": "Upload a poster image from your media library. Used when poster source is 'Media library'.",
            "component": {
              "name": "divi/upload",
              "type": "field"
            }
          }
        }
      }
    },
    "posterUrl": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": ""
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPoster",
            "attrName": "posterUrl.innerContent",
            "priority": 30,
            "render": true,
            "label": "Poster link",
            "description": "Direct URL to a poster image. Used when poster source is 'Other'.",
            "component": {
              "name": "divi/text",
              "type": "field",
              "props": {
                "placeholder": "https://example.com/poster.jpg"
              }
            }
          }
        }
      }
    },
    "aspectRatio": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "16:9"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentDimensions",
            "attrName": "aspectRatio.innerContent",
            "priority": 5,
            "render": true,
            "label": "Aspect Ratio",
            "description": "Select a standard aspect ratio or choose Custom to set exact dimensions.",
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "16:9": {
                    "label": "16:9 (Standard)"
                  },
                  "4:3": {
                    "label": "4:3 (Legacy)"
                  },
                  "21:9": {
                    "label": "21:9 (Ultrawide)"
                  },
                  "9:16": {
                    "label": "9:16 (Vertical)"
                  },
                  "1:1": {
                    "label": "1:1 (Square)"
                  },
                  "custom": {
                    "label": "Custom"
                  }
                }
              }
            }
          }
        }
      }
    },
    "videoWidth": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "1280"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentDimensions",
            "attrName": "videoWidth.innerContent",
            "priority": 10,
            "render": true,
            "label": "Width",
            "description": "Video width in pixels.",
            "component": {
              "name": "divi/range",
              "type": "field",
              "props": {
                "min": 0,
                "max": 1920,
                "step": 1,
                "allowedUnits": [],
                "defaultUnit": ""
              }
            }
          }
        }
      }
    },
    "videoHeight": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "720"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentDimensions",
            "attrName": "videoHeight.innerContent",
            "priority": 20,
            "render": true,
            "label": "Height",
            "description": "Video height in pixels.",
            "component": {
              "name": "divi/range",
              "type": "field",
              "props": {
                "min": 0,
                "max": 1080,
                "step": 1,
                "allowedUnits": [],
                "defaultUnit": ""
              }
            }
          }
        }
      }
    },
    "autoplay": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPlayback",
            "attrName": "autoplay.innerContent",
            "priority": 10,
            "render": true,
            "label": "Autoplay",
            "description": "Automatically start playing when the video is visible. Most browsers require 'Muted' to be enabled.",
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "muted": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPlayback",
            "attrName": "muted.innerContent",
            "priority": 20,
            "render": true,
            "label": "Muted",
            "description": "Start playback with audio muted.",
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPlayback",
            "attrName": "loop.innerContent",
            "priority": 30,
            "render": true,
            "label": "Loop",
            "description": "Restart the video automatically when it reaches the end.",
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPlayback",
            "attrName": "controls.innerContent",
            "priority": 40,
            "render": true,
            "label": "Controls",
            "description": "Show player controls (play, pause, volume, etc.).",
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "playsinline": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPlayback",
            "attrName": "playsinline.innerContent",
            "priority": 50,
            "render": true,
            "label": "Play inline",
            "description": "Keep the video inline on iOS instead of opening in fullscreen.",
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "responsive": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentPlayback",
            "attrName": "responsive.innerContent",
            "priority": 60,
            "render": true,
            "label": "Responsive",
            "description": "Make the video responsive to fill its container width while maintaining aspect ratio.",
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentVideoSource": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentVideoSource",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Video source"
          }
        }
      },
      "contentPoster": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentPoster",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Poster image"
          }
        }
      },
      "contentDimensions": {
        "panel": "content",
        "priority": 30,
        "groupName": "contentDimensions",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Dimensions"
          }
        }
      },
      "contentPlayback": {
        "panel": "content",
        "priority": 40,
        "groupName": "contentPlayback",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Playback options"
          }
        }
      }
    }
  }
}
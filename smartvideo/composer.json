{
	"name": "extension/smartvideo",
	"description": "SmartVideo plugin",
	"autoload": {
		"psr-4": {
			"Swarmify\\Smartvideo\\": "includes/Smartvideo/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Swarmify\\Smartvideo\\Tests\\": "tests/php/includes/Smartvideo/"
		}
	},
	"require": {
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"phpunit/phpunit": "^9",
		"brain/monkey": "^2.6",
		"yoast/phpunit-polyfills": "^1.0",
		"wp-phpunit/wp-phpunit": "^6.3"
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}